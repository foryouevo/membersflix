# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Domínio canônico de produção (SEM barra final, SEM "www") — usado no
# redirectTo do e-mail de redefinição de senha (components/EsqueceuSenhaModal.tsx),
# pra sempre apontar pro mesmo domínio (o que está cadastrado em Redirect
# URLs no painel do Supabase Auth), não importa se a pessoa acessou o site
# com ou sem "www". Deixar em branco/sem configurar localmente é normal —
# o código cai pra window.location.origin nesse caso.
NEXT_PUBLIC_SITE_URL=https://membersflix.com

# Google Drive (Service Account com a pasta compartilhada com o e-mail abaixo)
GOOGLE_SERVICE_ACCOUNT_EMAIL=drive-import@projeto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Endpoint /api/cron/check-pagamentos (usado pelo Vercel Cron ou similar)
CRON_SECRET=um-segredo-aleatorio
